<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.glory</groupId>
    <artifactId>spark</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>spark-core</module>
        <module>spark-resource</module>
        <module>spark-content</module>
        <module>spark-app</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.boot.version>3.3.5</spring.boot.version>
        <persistence.version>3.1.0</persistence.version>
        <foundation.version>1.0-SNAPSHOT</foundation.version>
        <spark.version>1.0-SNAPSHOT</spark.version>
        <mysql.version>8.0.33</mysql.version>
        <liquibase.core.version>4.29.0</liquibase.core.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-web</artifactId>
                <version>${spring.boot.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.persistence</groupId>
                <artifactId>jakarta.persistence-api</artifactId>
                <version>${persistence.version}</version>
            </dependency>
            <dependency>
                <groupId>com.glory.foundation.basic</groupId>
                <artifactId>basic-enhance</artifactId>
                <version>${foundation.version}</version>
            </dependency>
            <dependency>
                <groupId>com.glory.foundation.data.jpa</groupId>
                <artifactId>data-jpa</artifactId>
                <version>${foundation.version}</version>
            </dependency>
            <dependency>
                <groupId>com.glory.foundation.client</groupId>
                <artifactId>rest-client</artifactId>
                <version>${foundation.version}</version>
            </dependency>
            <dependency>
                <groupId>com.glory.spark</groupId>
                <artifactId>spark-core</artifactId>
                <version>${spark.version}</version>
            </dependency>
            <dependency>
                <groupId>com.glory.spark</groupId>
                <artifactId>spark-content</artifactId>
                <version>${spark.version}</version>
            </dependency>
            <dependency>
                <groupId>com.glory.spark</groupId>
                <artifactId>spark-resource</artifactId>
                <version>${spark.version}</version>
            </dependency>
            <dependency>
                <groupId>mysql</groupId>
                <artifactId>mysql-connector-java</artifactId>
                <version>${mysql.version}</version>
            </dependency>
            <dependency>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-core</artifactId>
                <version>${liquibase.core.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.14.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>