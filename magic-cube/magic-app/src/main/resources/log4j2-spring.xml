<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO" >
    <Properties>
        <!-- 定义日志格式和路径 -->
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %dm%n</Property>
        <Property name="APP_NAME">magic cube</Property>
